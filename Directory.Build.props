<Project>
  <!--
    Shared settings for every project in the repo. A project only needs its AssemblyName and its own files.
    Game path: set MOONSWEEPERS_DIR, or put <GameDir> in a gitignored Directory.Build.local.props next to this file.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0618;CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Dev builds add [Dev] config entries and test helpers. package.ps1 builds with -p:DevBuild=false. -->
    <DevBuild Condition="'$(DevBuild)' == ''">true</DevBuild>
    <DefineConstants Condition="'$(DevBuild)' == 'true'">$(DefineConstants);DEVBUILD</DefineConstants>

    <GameDir Condition="'$(GameDir)' == '' and '$(MOONSWEEPERS_DIR)' != ''">$(MOONSWEEPERS_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</GameDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
    <!-- false: build without copying into the game (packaging, CI). -->
    <InstallToGame Condition="'$(InstallToGame)' == ''">true</InstallToGame>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCoreDir)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>
</Project>
