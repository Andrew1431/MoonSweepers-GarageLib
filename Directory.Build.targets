<Project>
  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SkipGameDirCheck)' != 'true'">
    <Error Condition="!Exists('$(InteropDir)')"
           Text="No BepInEx interop assemblies at '$(InteropDir)'. Install BepInEx + ModEngine, launch the game once, and set MOONSWEEPERS_DIR (or GameDir in Directory.Build.local.props) if the game isn't in the default Steam folder." />
  </Target>

  <Target Name="CopyVehicleStats" AfterTargets="Build" Condition="'@(VehicleStatsFile)' != ''">
    <Copy SourceFiles="@(VehicleStatsFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Each plugin goes to BepInEx/plugins/<AssemblyName>/. -->
  <Target Name="CopyPluginToGame" AfterTargets="Build" Condition="'$(InstallToGame)' == 'true'">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath);@(VehicleStatsFile)" DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)" />
  </Target>
</Project>
