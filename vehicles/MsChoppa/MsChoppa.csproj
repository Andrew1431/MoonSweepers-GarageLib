<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MsChoppa</AssemblyName>
    <RootNamespace>MsChoppa</RootNamespace>
    <!-- Paused (2026-11-01): builds, but dev builds no longer install it into the game. Remove this line to bring it back. -->
    <InstallToGame>false</InstallToGame>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)shared\Rotorcraft\*.cs" LinkBase="Rotorcraft" />
    <EmbeddedResource Include="Resources\ms_choppa.bin" LogicalName="ms_choppa.bin" />
    <ProjectReference Include="$(RepoRoot)src\GarageLib\GarageLib.csproj" Private="false" />
  </ItemGroup>
</Project>
